<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<RootNamespace>PowerShield_R</RootNamespace>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnableWindowsTargeting>true</EnableWindowsTargeting>
		<SatelliteResourceLanguages>es</SatelliteResourceLanguages>

	</PropertyGroup>

	<ItemGroup>
		<Content Include="assets\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="GenerateBuildDate" BeforeTargets="BeforeCompile">
		<PropertyGroup>
			<BuildTimestamp>$([System.DateTime]::UtcNow.ToString("yyMMddHHmm"))</BuildTimestamp>
		</PropertyGroup>

		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
		</ItemGroup>

		<WriteLinesToFile
			File="$(IntermediateOutputPath)BuildInfo.g.cs"
			Lines="namespace PowerShield_R%3B public static class BuildInfo { public const string BUILD = &quot;$(BuildTimestamp)&quot;%3B }"
			Overwrite="true" />
	</Target>

</Project>